# Copy to .env (not committed) to change these.

# Which API the app talks to:
#   mock  answers are kept in this browser only (default, works without a backend)
#   http  the real backend: /api/v1/public/early-access/...
VITE_API_MODE=mock

# `npm run dev` with VITE_API_MODE=http: where the dev server forwards /api.
# VITE_DEV_API_TARGET=http://localhost:8082

# Which consent wording the retailer agreed to; stored with every response.
VITE_CONSENT_VERSION=2026-10-ea-2
